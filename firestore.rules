rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /zones/{zoneId} {
      // Public read — fans and the map UI need to read zones without logging in
      allow read: if true;

      // Allow crowd level updates from the admin panel (no auth on free Spark plan).
      // Defense-in-depth: strictly validate the written field and its allowed values.
      // Only the crowd_level and updated_by fields may be written.
      allow update: if request.resource.data.crowd_level in ['low', 'medium', 'high']
                    && request.resource.data.keys().hasAll(['crowd_level', 'updated_by', 'updated_at']);

      // Deny creates and deletes from clients — seeding is done via the seed script
      allow create, delete: if false;
    }

    // Deny all access to any other collection by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
