# ============================================================
# Venue Sahayak — Cloud Functions Non-Secret Config
# ============================================================
# Copy this file to functions/.env and fill in values.
# This file is loaded automatically by Firebase Functions' native dotenv support.
#
# IMPORTANT: Do NOT put GEMINI_API_KEY here.
# GEMINI_API_KEY is a true secret managed via Firebase Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
# ============================================================

# The Gemini model ID to use for inference.
# Default: gemini-2.0-flash  |  See: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# CORS: comma-separated list of allowed origins. Local dev uses localhost:5000.
ALLOWED_ORIGIN=http://localhost:5000

# Rate limit: maximum chat requests per minute per IP.
RATE_LIMIT_PER_MINUTE=10

# Maximum character length for a single chat message.
MAX_MESSAGE_LENGTH=500

# Cloud Function memory allocation (e.g. 256MiB, 512MiB).
FUNCTIONS_MEMORY=256MiB

# Cloud Function timeout in seconds.
FUNCTIONS_TIMEOUT_SECONDS=30
