# ============================================================
# Venue Sahayak — Environment Variables Reference
# ============================================================
# Copy this file to .env (never commit .env) and fill in values.
# See the "Environment Setup" section in README.md for full details.
# ============================================================

# --- Gemini API ---
# GEMINI_API_KEY is a TRUE SECRET — do NOT place it here or in functions/.env.
# Set it via Firebase Secret Manager: firebase functions:secrets:set GEMINI_API_KEY
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# The Gemini model ID to use for inference.
# Default: gemini-2.0-flash  |  Options: see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# --- Firebase ---
# Your Firebase project ID (visible in Firebase Console > Project Settings).
FIREBASE_PROJECT_ID=

# Cloud Functions deployment region. asia-south1 = Mumbai (low latency for India).
# See full list: https://firebase.google.com/docs/functions/manage-functions#set_timeout_and_memory_allocation
FIREBASE_REGION=asia-south1

# --- Google Maps ---
# Client-exposed Maps JS API key. NOT a secret — restrict it instead:
# Google Cloud Console > APIs & Services > Credentials > HTTP referrers
# Restrict to your Firebase Hosting domain (e.g. https://your-project.web.app/*).
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# --- App Config ---
# CORS: comma-separated list of allowed HTTP origins for Cloud Functions.
# During local dev: http://localhost:5000  |  Production: your Firebase Hosting URL.
ALLOWED_ORIGIN=http://localhost:5000

# Rate limit: maximum number of chat requests per minute per IP address.
RATE_LIMIT_PER_MINUTE=10

# Maximum character length accepted for a single chat message.
MAX_MESSAGE_LENGTH=500

# Cloud Function allocated memory. Valid values: 128MB, 256MB, 512MB, 1GB, 2GB, 4GB, 8GB.
FUNCTIONS_MEMORY=256MiB

# Cloud Function maximum execution time in seconds (must cover Gemini timeout + retries).
FUNCTIONS_TIMEOUT_SECONDS=30
