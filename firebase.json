{
  // hosting config: serves static files from "public" directory, redirects all other routes to index.html
  // functions config: sets source directory to "functions"
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/chat",
        "function": "chat"
      },
      {
        "source": "/updateCrowdLevel",
        "function": "updateCrowdLevel"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
